{
  "name": "folder-grid",
  "productName": "folder-grid",
  "version": "0.5.0",
  "description": "直接放在 Windows 桌面上的文件收纳图标，点击展开玻璃卡",
  "main": "src/main.js",
  "author": "luckily268",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luckily268/Foldergrid.git"
  },
  "bugs": {
    "url": "https://github.com/luckily268/Foldergrid/issues"
  },
  "homepage": "https://github.com/luckily268/Foldergrid#readme",
  "scripts": {
    "postinstall": "install-electron && node scripts/vendor-pdf.cjs",
    "start": "electron .",
    "check": "node scripts/check.cjs",
    "test": "node --test tests/storage.test.cjs tests/preview.test.cjs tests/workspace.test.cjs tests/updates.test.cjs tests/startup-layouts.test.cjs tests/preview-plus.test.cjs tests/micro.test.cjs tests/bookcases.test.cjs",
    "test:smoke": "electron tests/electron-smoke.cjs",
    "pack": "npm run check && npm test && electron-builder --win --dir --publish never",
    "dist": "npm run check && npm test && electron-builder --win --x64 --publish never && node scripts/checksums.cjs",
    "test:desktop": "electron tests/desktop-smoke.cjs",
    "test:window": "electron tests/electron-smoke.cjs",
    "test:updates": "electron tests/update-download.cjs",
    "test:startup": "electron tests/login-item-smoke.cjs",
    "test:pdf-package": "electron tests/packaged-preview.cjs"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "pdfjs-dist": "6.4.299"
  },
  "build": {
    "appId": "com.luckily268.foldergrid",
    "productName": "folder-grid",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "src/**/*",
      "media/**/*",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "folder-grid"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "folder-grid",
      "artifactName": "folder-grid-setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "luckily268",
        "repo": "Foldergrid",
        "releaseType": "draft"
      }
    ]
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "electron-updater": "6.8.12",
    "koffi": "3.3.5"
  }
}
